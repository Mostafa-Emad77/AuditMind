# Copy to `.env` in this folder and set values. Never commit `.env`.

# OpenRouter — https://openrouter.ai/keys (required for LLM calls)
OPENROUTER_API_KEY=

# Optional OpenRouter overrides (defaults are in app/config.py)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=tencent/hy4-preview
# OPENROUTER_MODEL_NER_ARABIC=google/gemini-2.5-flash-lite
# OPENROUTER_MODEL_RELATION=minimax/minimax-m2.5
# OPENROUTER_REASONING=true

# Neo4j — use Aura or any reachable instance (not started by Docker Compose)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant — with Docker Compose on the host machine, use:
QDRANT_URL=http://localhost:6333

# Embeddings — OpenAI-compatible /embeddings through OpenRouter using OPENROUTER_API_KEY.
# Changing the embedding model changes the vector size: use a new QDRANT_COLLECTION.
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Redis — local dev outside Compose:
REDIS_URL=redis://localhost:6379

# API key auth (optional — comma-separated list; empty = no auth)
# API_KEYS=key1,key2

# App
CORS_ORIGINS=http://localhost:3000
