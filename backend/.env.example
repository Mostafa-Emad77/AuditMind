# Copy to `.env` in this folder and set values. Never commit `.env`.

# OpenRouter — https://openrouter.ai/keys (required for LLM calls)
OPENROUTER_API_KEY=

# Optional OpenRouter overrides (defaults are in app/config.py)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-oss-20b:nitro
# OPENROUTER_MODEL_NER_ARABIC=qwen/qwen3.5-122b-a10b
# OPENROUTER_MODEL_RELATION=anthropic/claude-sonnet-4.6
# OPENROUTER_REASONING=true

# Google AI Studio — alternative provider (set LLM_PROVIDER=google)
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-pro

# Neo4j — use Aura or any reachable instance (not started by Docker Compose)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant — with Docker Compose on the host machine, use:
QDRANT_URL=http://localhost:6333

# Redis — local dev outside Compose:
REDIS_URL=redis://localhost:6379

# API key auth (optional — comma-separated list; empty = no auth)
# API_KEYS=key1,key2

# App
CORS_ORIGINS=http://localhost:3000
